{
  "manifest_version": 3,
  "name": "YouTube Subscriptions Helper",
  "version": "1.0",
  "description": "Syncs YouTube cookies to the YouTube Subscriptions Organizer app for mark-as-watched functionality.",
  "permissions": [
    "cookies"
  ],
  "host_permissions": [
    "https://*.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost:*/*", "https://*.github.dev/*", "https://*.codespaces.dev/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
