{
  "servers": {
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--autoConnect",
        "--categoryExtensions=true",
        "--usageStatistics=false",
        "--performanceCrux=false",
        "--viewport=1440x900"
      ]
    }
  }
}
