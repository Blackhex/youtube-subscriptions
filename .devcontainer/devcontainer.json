{
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.pylint",
        "github.copilot",
        "darthminos.workspace-tasks",
        "mhutchie.git-graph"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      }
    }
  },
  "forwardPorts": [
    8000,
    8001
  ],
  "features": {
    "ghcr.io/devcontainers/features/node:1": {}
  },
  "image": "mcr.microsoft.com/devcontainers/python:3.13",
  "name": "YouTube Subscriptions Organizer",
  "postCreateCommand": "pip install -r requirements.txt && npm install -g rebase-editor"
}